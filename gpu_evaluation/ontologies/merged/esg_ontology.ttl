        rso:Disclosure_Disclosure_Requirement_GOV_5_Risk_management_and_internal_controls_over_sustainability_reporting_A,
        rso:Disclosure_Disclosure_Requirement_IRO_1_Description_of_the_processes_to_identify_and_assess,
        rso:Disclosure_Disclosure_Requirement_IRO_2_Disclosure_Requirements_in_ESRS_covered_by_the_undertaking_s_sustaina,
        rso:Disclosure_Disclosure_Requirement_IRO_2_Disclosure_requirements_in_ESRS_covered_by_the,
        rso:Disclosure_Disclosure_Requirement_SBM_1_Strategy_business_model_and_value_chain_AR_12_To_provide_the_informat,
        rso:Disclosure_Disclosure_Requirement_SBM_1_Strategy_business_model_and_value_chain_Disclosure_Requirement_SBM_2,
        rso:Disclosure_Disclosure_Requirement_SBM_3_Material_impacts_risks_and_opportunities_and_their_interaction_with,
        rso:Disclosure_Disclosure_Requirement_of_an_ESRS_including_a_specific_datapoint_prescribed_by_a_Disclosure_Require,
        rso:Disclosure_Disclosure_Requirement_related_to_ESRS_2_IRO_1_Description_of_processes_to_identify_and_assess_mater,
