        rso:Disclosure_Disclosure_Requirement_GOV_4_Statement_on_due_diligence,
        rso:Disclosure_Disclosure_Requirement_GOV_4_Statement_on_due_diligence_Disclosure_Requirement_GOV_5_Risk_manage,
