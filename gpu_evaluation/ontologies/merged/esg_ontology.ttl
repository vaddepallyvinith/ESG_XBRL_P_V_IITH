rso:Requirement_2159775148917982487 a rso:Requirement ;
    rso:belongsToDisclosure rso:Disclosure_Disclosure_Requirement_IRO_2_Disclosure_requirements_in_ESRS_covered_by_the ;
    rso:originalText "material sustainability matters 5. Metrics and targets Minimum disclosure requirement – Metrics MDR-M – Metrics in relation to material sustainability matters"^^xsd:string ;
