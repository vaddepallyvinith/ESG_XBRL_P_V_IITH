rso:Requirement_-2111519568531771777 a rso:Requirement ;
    rso:belongsToDisclosure rso:Disclosure_Disclosure_401_3_Parental_leave ;
    rso:originalText "Total number of employees that did return to work after\\nparental leave ___________________________________________\\nReturn to work rate =\\nx 100\\nTotal number of employees due to return to work after\\ntaking parental leave\\nTotal number of employees retained 12 months after\\nreturning to work following a period of parental leave ___________________________________________\\nRetention rate =\\nx 100\\nTotal number of employees returning from parental\\nleave in the prior reporting period(s)\\nGuidance for Disclosure 401-3 Employees entitled to parental leave means those employees that are covered by organizational policies, agreements or contracts that contain parental leave entitlements."^^xsd:string ;
    rso:pageEnd 10 ;
    rso:pageStart 10 ;
    rso:sectionLabel "RECOMMENDATIONS"^^xsd:string ;
    rso:sourceDocument "GRI 401_ Employment 2016.pdf"^^xsd:string ;
    schema1:identifier "RECOMMENDATIONS"^^xsd:string ;
    schema1:name "RECOMMENDATIONS"^^xsd:string ;
    schema1:text "Total number of employees that did return to work after\\nparental leave ___________________________________________\\nReturn to work rate =\\nx 100\\nTotal number of employees due to return to work after\\ntaking parental leave\\nTotal number of employees retained 12 months after\\nreturning to work following a period of parental leave ___________________________________________\\nRetention rate =\\nx 100\\nTotal number of employees returning from parental\\nleave in the prior reporting period(s)\\nGuidance for Disclosure 401-3 Employees entitled to parental leave means those employees that are covered by organizational policies, agreements or contracts that contain parental leave entitlements."^^xsd:string .

