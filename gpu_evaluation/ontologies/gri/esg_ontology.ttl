    rso:sectionLabel "Disclosure 403-6 Promotion of worker health 16"^^xsd:string ;
    rso:sourceDocument "GRI 403_ Occupational Health and Safety 2018.pdf"^^xsd:string ;
    schema1:identifier "Disclosure 403-6 Promotion of worker health 16"^^xsd:string ;
    schema1:name "Disclosure 403-6 Promotion of worker health 16"^^xsd:string ;
