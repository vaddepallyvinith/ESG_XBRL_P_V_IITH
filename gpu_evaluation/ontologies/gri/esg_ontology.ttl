rso:Disclosure_Disclosure_2_18_Evaluation_of_the_performance_of_t a rso:Disclosure ;
    rso:belongsToTopic rso:Topic_GRI_2_General_Disclosures_2021_3 ;
    rso:originalText "Disclosure 2-18 Evaluation of the performance of the highest governance body 29"^^xsd:string,
        "Disclosure 2-18 Evaluation of the performance of the highest governance body\\nThe organization shall: REQUIREMENTS\\na.\\ndescribe the processes for evaluating the performance of the highest governance body in overseeing the management of the organization’s impacts on the economy, environment, and people;\\nreport whether the evaluations are independent or not, and the frequency of the evaluations; b.\\ndescribe actions taken in response to the evaluations, including changes to the composition of the highest governance body and organizational practices. c.\\nGRI 2: General Disclosures 2021 30"^^xsd:string ;
    rso:pageEnd 3,
        30 ;
    rso:pageStart 3,
        29 ;
    rso:sectionLabel "Disclosure 2-18 Evaluation of the performance of the highest governance body"^^xsd:string,
        "Disclosure 2-18 Evaluation of the performance of the highest governance body 29"^^xsd:string ;
    rso:sourceDocument "GRI 2_ General Disclosures 2021.pdf"^^xsd:string ;
    schema1:identifier "Disclosure 2-18 Evaluation of the performance of t"^^xsd:string ;
    schema1:name "Disclosure 2-18 Evaluation of the performance of the highest governance body"^^xsd:string,
        "Disclosure 2-18 Evaluation of the performance of the highest governance body 29"^^xsd:string ;
    schema1:text "Disclosure 2-18 Evaluation of the performance of the highest governance body 29"^^xsd:string,
        "Disclosure 2-18 Evaluation of the performance of the highest governance body\\nThe organization shall: REQUIREMENTS\\na.\\ndescribe the processes for evaluating the performance of the highest governance body in overseeing the management of the organization’s impacts on the economy, environment, and people;\\nreport whether the evaluations are independent or not, and the frequency of the evaluations; b.\\ndescribe actions taken in response to the evaluations, including changes to the composition of the highest governance body and organizational practices. c.\\nGRI 2: General Disclosures 2021 30"^^xsd:string .

