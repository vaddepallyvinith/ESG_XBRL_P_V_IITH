rso:Disclosure_Disclosure_401_3_Parental_leave a rso:Disclosure ;
    rso:belongsToTopic rso:Topic_GRI_401_Employment_2016_3 ;
    rso:originalText "Disclosure 401-3 Parental leave\\nThe reporting organization shall report the following information: REQUIREMENTS\\nTotal number of employees that were entitled to parental leave, by gender. a.\\nTotal number of employees that took parental leave, by gender. b.\\nTotal number of employees that returned to work in the reporting period after parental leave ended, by gender. c.\\nTotal number of employees that returned to work after parental leave ended that were still employed 12 months after their return to work, by gender. d.\\nReturn to work and retention rates of employees that took parental leave, by gender. e."^^xsd:string ;
    rso:pageEnd 15 ;
    rso:pageStart 10 ;
    rso:requires rso:Requirement_-2111519568531771777,
        rso:Requirement_-4772544435537603057 ;
    rso:sectionLabel "Disclosure 401-3 Parental leave"^^xsd:string ;
    rso:sourceDocument "GRI 401_ Employment 2016.pdf"^^xsd:string ;
    schema1:identifier "Disclosure 401-3 Parental leave"^^xsd:string ;
    schema1:name "Disclosure 401-3 Parental leave"^^xsd:string ;
    schema1:text "Disclosure 401-3 Parental leave\\nThe reporting organization shall report the following information: REQUIREMENTS\\nTotal number of employees that were entitled to parental leave, by gender. a.\\nTotal number of employees that took parental leave, by gender. b.\\nTotal number of employees that returned to work in the reporting period after parental leave ended, by gender. c.\\nTotal number of employees that returned to work after parental leave ended that were still employed 12 months after their return to work, by gender. d.\\nReturn to work and retention rates of employees that took parental leave, by gender. e."^^xsd:string .

