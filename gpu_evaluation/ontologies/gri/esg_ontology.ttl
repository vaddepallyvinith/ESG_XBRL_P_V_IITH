rso:Requirement_-4204907029483943124 a rso:Requirement ;
    rso:belongsToDisclosure rso:Disclosure_Disclosure_403_5_Worker_training_on_occupational_h ;
    rso:originalText "how training needs are assessed; • how the training is designed and delivered, including the content or topics addressed, the competency of trainers, which workers receive the training, the frequency of the training, and whether the training is provided in a language easily understood by workers;\\n•\\nwhether the training is provided free of charge and during paid working hours – if not, whether it is mandatory for workers to attend, and whether they are compensated for this; •\\nhow the effectiveness of the training is evaluated. •\\nGRI 403: Occupational Health and Safety 2018 16"^^xsd:string ;
    rso:pageEnd 16 ;
