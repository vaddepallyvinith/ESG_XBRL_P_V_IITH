rso:Disclosure_Disclosure_2_8_Workers_who_are_not_employees_18 a rso:Disclosure ;
    rso:belongsToTopic rso:Topic_GRI_2_General_Disclosures_2021_3 ;
    rso:originalText "Disclosure 2-8 Workers who are not employees 18"^^xsd:string ;
    rso:pageEnd 3 ;
    rso:pageStart 3 ;
    rso:sectionLabel "Disclosure 2-8 Workers who are not employees 18"^^xsd:string ;
    rso:sourceDocument "GRI 2_ General Disclosures 2021.pdf"^^xsd:string ;
    schema1:identifier "Disclosure 2-8 Workers who are not employees 18"^^xsd:string ;
    schema1:name "Disclosure 2-8 Workers who are not employees 18"^^xsd:string ;
