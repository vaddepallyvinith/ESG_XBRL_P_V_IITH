        38 ;
    rso:pageStart 15,
        18 ;
    rso:requires rso:Requirement_-4411972299501916729 ;
    rso:sectionLabel "Disclosure 3-2 List of material topics"^^xsd:string,
        "Disclosure 3-2 List of material topics •"^^xsd:string ;
    rso:sourceDocument "GRI 1_ Foundation 2021.pdf"^^xsd:string,
        "GRI 3_ Material Topics 2021.pdf"^^xsd:string ;
